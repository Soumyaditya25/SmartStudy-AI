# ===========================================
# SmartStudy AI — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# ---- Database (PostgreSQL) ----
# Free option: Neon (https://neon.tech - free tier, 0.5GB)
# Get connection string from Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ---- Authentication ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here_generate_with_openssl
# Your app's public URL (Vercel auto-assigns this, update after first deploy)
NEXTAUTH_URL=https://your-app.vercel.app

# ---- AI Providers (use at least one) ----

# Google Gemini (Free tier)
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Groq (Recommended — generous free tier: 14400 req/day)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---- App Config ----
NODE_ENV=production
