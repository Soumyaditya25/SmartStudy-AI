# ===========================================
# SmartStudy AI — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# ---- Database (PostgreSQL) ----
# For local dev: Use a local PostgreSQL or Neon (https://neon.tech - free)
# For Railway: This is auto-filled by the Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/smartstudy

# ---- Authentication ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here_generate_with_openssl
# Your app's public URL (Railway auto-assigns this)
NEXTAUTH_URL=https://your-app.up.railway.app

# ---- AI Providers (use at least one) ----

# Google Gemini (Free tier)
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Groq (Recommended — generous free tier: 14400 req/day)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---- App Config ----
NODE_ENV=production
