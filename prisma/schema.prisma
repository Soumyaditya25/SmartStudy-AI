// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  levelPref     String    @default("intermediate") // beginner, intermediate, advanced
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      AuthSession[]

  documents     Document[]
  studySessions StudySession[]
  practiceQs    PracticeQuestion[]
  chunks        Chunk[]
  flashcards    Flashcard[]
  quizzes       Quiz[]
  quizAttempts  QuizAttempt[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  name          String
  status        String    @default("processing") // upload, processing, ready, failed
  storagePath   String    // local path or cloud path where the file is stored
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceQs    PracticeQuestion[]
  chunks        Chunk[]
  flashcards    Flashcard[]
  quizzes       Quiz[]
  
  @@index([userId])
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  page       Int      @default(1)
  chunkIndex Int
  content    String
  embedding  String   // Stored as JSON string [number, number, ...]
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
}

model StudySession {
  id            String    @id @default(cuid())
  userId        String
  title         String    @default("New Session")
  turns         String    // Stored as JSON string to hold Q/A pairs and source metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PracticeQuestion {
  id            String    @id @default(cuid())
  userId        String
  documentId    String
  difficulty    String    // beginner, intermediate, advanced
  question      String
  answer        String
  solutionSteps String    // Stored as markdown string
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
}

model Flashcard {
  id            String    @id @default(cuid())
  userId        String
  documentId    String
  front         String
  back          String
  // SM-2 Spaced Repetition fields
  nextReview    DateTime  @default(now())
  interval      Int       @default(0)   // in days
  easeFactor    Float     @default(2.5) // starting ease factor
  repetitions   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([userId, nextReview]) // Efficient querying for due cards
}

model Quiz {
  id            String    @id @default(cuid())
  userId        String
  documentId    String
  title         String
  timeLimit     Int?      // in seconds, null if no timer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([userId])
  @@index([documentId])
}

model QuizQuestion {
  id            String    @id @default(cuid())
  quizId        String
  question      String
  options       String    // Stored as JSON string ["A", "B", "C", "D"]
  correctOption Int       // 0, 1, 2, or 3
  explanation   String
  
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String
  userId        String
  score         Int       // Number of correct answers
  timeSpent     Int       // Time spent in seconds
  createdAt     DateTime  @default(now())

  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}
